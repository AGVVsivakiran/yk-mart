Options -MultiViews
RewriteEngine On
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.html [QSA,L]

# -------------------------------------------------------
# ALLOW RAZORPAY IFRAME - Fix "accelerometer not allowed"
# and "Refused to get unsafe header" errors in production
# -------------------------------------------------------

# Allow Razorpay features in browser (sensors, payment APIs, etc.)
<IfModule mod_headers.c>

    # This is the KEY FIX: Allow the browser features Razorpay needs
    Header always set Permissions-Policy "accelerometer=*, camera=*, geolocation=*, gyroscope=*, magnetometer=*, microphone=*, payment=*, usb=*"

    # Allow Razorpay's domain to load in iframes
    Header always set Content-Security-Policy "frame-ancestors 'self' https://*.razorpay.com; frame-src 'self' https://*.razorpay.com https://*.razorpay-checkout.com;"

    # Allow cross-origin requests from Razorpay
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization, X-Requested-With"

    # Cache control for static assets
    <FilesMatch "\.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$">
        Header set Cache-Control "max-age=31536000, public"
    </FilesMatch>

    # No cache for HTML (so users always get latest build)
    <FilesMatch "\.html$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

</IfModule>

# Handle OPTIONS preflight requests
<IfModule mod_rewrite.c>
    RewriteCond %{REQUEST_METHOD} OPTIONS
    RewriteRule ^(.*)$ $1 [R=200,L]
</IfModule>
